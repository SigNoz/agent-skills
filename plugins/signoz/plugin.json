{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "signoz",
  "version": "2026.10.3000",
  "description": "Official SigNoz plugin for MCP setup, docs, queries, dashboards, and alerts",
  "author": {
    "name": "SigNoz",
    "url": "https://signoz.io"
  },
  "homepage": "https://signoz.io",
  "repository": "https://github.com/SigNoz/agent-skills",
  "license": "MIT",
  "keywords": [
    "signoz",
    "opentelemetry",
    "observability",
    "mcp",
    "clickhouse",
    "tracing",
    "logging"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SigNoz",
        "shortDescription": "Metrics, logs, traces & alerts",
        "longDescription": "Query metrics, logs, and traces; investigate issues; manage dashboards, alerts, and saved views in SigNoz. Find instrumentation and troubleshooting guidance in the SigNoz documentation.",
        "developerName": "SigNoz",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://signoz.io",
        "supportURL": "https://signoz.io/support/",
        "privacyPolicyURL": "https://signoz.io/legal/privacy/",
        "termsOfServiceURL": "https://signoz.io/legal/terms-of-service/",
        "composerIcon": "./assets/signoz-icon.png",
        "logo": "./assets/signoz-icon.png",
        "defaultPrompt": [
          "Set up SigNoz MCP for my SigNoz Cloud region.",
          "Investigate checkout errors across logs, traces, and metrics.",
          "Create a checkout dashboard and 5xx alert."
        ]
      }
    }
  }
}
